# ==============================================================================
# Calculator Vault Environment Variables
# Copy to .env.local (web) and .env (mobile) — NEVER commit real secrets.
# ==============================================================================

# --- Supabase (Free Tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Expo public mirrors (same anon key; NEVER put service_role key in client apps)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Web App / PWA ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CalX

# --- Optional: Web Push (VAPID public key for browser notifications) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Supabase Edge Function / Server-only (set in Supabase Dashboard Secrets) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-clients
# VAPID_PRIVATE_KEY=
